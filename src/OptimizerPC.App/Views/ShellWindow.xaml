<Window x:Class="OptimizerPC.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:OptimizerPC.App.Localization"
        xmlns:controls="clr-namespace:OptimizerPC.App.Controls"
        xmlns:vm="clr-namespace:OptimizerPC.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Optimizer PC"
        Width="1360"
        Height="820"
        MinWidth="1024"
        MinHeight="660"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Window.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ========================= BARRA DE TITULO ========================= -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="{StaticResource Radius.Small}"
                                Background="{DynamicResource Brush.Accent.Soft}">
                            <Path Data="{StaticResource Icon.Optimization}"
                                  Stretch="Uniform"
                                  Width="15"
                                  Height="15"
                                  Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="1.9"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock Text="Optimizer PC"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="{StaticResource Font.Size.Subtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding VersionText, StringFormat=v{0}}"
                                   Margin="7,1,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button Style="{StaticResource Button.Icon}"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="{loc:Loc Shell.Tooltip.Theme}"
                                Margin="0,0,4,0">
                            <Path Data="{StaticResource Icon.Theme.Dark}"
                                  Stretch="Uniform"
                                  Width="15"
                                  Height="15"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round" />
                        </Button>

                        <Button x:Name="NotificationsButton"
                                Style="{StaticResource Button.Icon}"
                                Command="{Binding ToggleNotificationsCommand}"
                                ToolTip="{loc:Loc Shell.Tooltip.Notifications}"
                                Margin="0,0,4,0">
                            <Grid>
                                <Path Data="{StaticResource Icon.Bell}"
                                      Stretch="Uniform"
                                      Width="15"
                                      Height="15"
                                      Stroke="{DynamicResource Brush.Text.Secondary}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" />
                                <Border Width="15"
                                        Height="15"
                                        Margin="0,-9,-9,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="{StaticResource Radius.Pill}"
                                        Background="{DynamicResource Brush.Accent}"
                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding UnreadCount}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.OnAccent}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource Brush.Border}" />

                        <Button Style="{StaticResource Button.Caption}"
                                Click="OnMinimizeClick"
                                ToolTip="{loc:Loc Shell.Tooltip.Minimize}">
                            <Path Data="{StaticResource Icon.Window.Minimize}"
                                  Stretch="Uniform" Width="12" Height="12"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.5" />
                        </Button>

                        <Button Style="{StaticResource Button.Caption}"
                                Click="OnMaximizeClick"
                                ToolTip="{loc:Loc Shell.Tooltip.Maximize}">
                            <Path x:Name="MaximizeIcon"
                                  Data="{StaticResource Icon.Window.Maximize}"
                                  Stretch="Uniform" Width="11" Height="11"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.4" />
                        </Button>

                        <Button Style="{StaticResource Button.Caption.Close}"
                                Click="OnCloseClick"
                                ToolTip="{loc:Loc Shell.Tooltip.Close}">
                            <Path Data="{StaticResource Icon.Window.Close}"
                                  Stretch="Uniform" Width="11" Height="11"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.4" />
                        </Button>
                    </StackPanel>

                    <!-- Flyout do sino -->
                    <Popup x:Name="NotificationsPopup"
                           PlacementTarget="{Binding ElementName=NotificationsButton}"
                           Placement="Bottom"
                           HorizontalOffset="-320"
                           VerticalOffset="6"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}">
                        <Border Width="384"
                                MaxHeight="460"
                                Background="{DynamicResource Brush.OverlayStrong}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Large}"
                                Effect="{DynamicResource Effect.Flyout}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="16,14,12,10">
                                    <TextBlock Text="{loc:Loc Shell.Notifications.Title}"
                                               Style="{StaticResource Text.Subtitle}" />
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource Button.Icon}"
                                            Command="{Binding MarkAllReadCommand}"
                                            ToolTip="{loc:Loc Shell.Notifications.MarkAllRead}">
                                        <Path Data="{StaticResource Icon.Check}"
                                              Stretch="Uniform" Width="14" Height="14"
                                              Stroke="{DynamicResource Brush.Text.Secondary}"
                                              StrokeThickness="1.7"
                                              StrokeLineJoin="Round" />
                                    </Button>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,0">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalContentAlignment="Stretch"
                                                            Padding="0"
                                                            Margin="0,0,0,4"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Border Background="{DynamicResource Brush.Card}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Medium}"
                                                                Padding="12,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Grid.Column="0"
                                                                         Width="7" Height="7"
                                                                         Margin="0,5,10,0"
                                                                         VerticalAlignment="Top"
                                                                         Fill="{DynamicResource Brush.Accent}" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Message}"
                                                                               Style="{StaticResource Text.Caption}"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding Detail}"
                                                                               Style="{StaticResource Text.Caption}"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,3,0,0"
                                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                                                    <TextBlock Text="{Binding CreatedText}"
                                                                               Style="{StaticResource Text.Caption}"
                                                                               Margin="0,5,0,0"
                                                                               Opacity="0.75" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{loc:Loc Shell.Notifications.Empty}"
                                                   Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,26,0,26"
                                                   Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVisibility.Invert}}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid Grid.Row="2" Margin="12,8,12,12">
                                    <TextBlock Text="{loc:Loc Shell.Notifications.Privacy}"
                                               Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="230"
                                               HorizontalAlignment="Left" />
                                    <Button Style="{StaticResource Button.Ghost}"
                                            HorizontalAlignment="Right"
                                            Padding="10,4"
                                            Command="{Binding ClearNotificationsCommand}"
                                            Content="{loc:Loc Shell.Notifications.Clear}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ========================= CORPO ========================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="{Binding SidebarWidth}"
                        Background="{DynamicResource Brush.Sidebar}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,10,0,10">
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource Nav.Section}"
                                                       Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility.Invert}}" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource Nav.Item}"
                                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                      Command="{Binding SelectCommand}"
                                                                      Content="{Binding}"
                                                                      ToolTip="{Binding Title}">
                                                            <ToggleButton.ContentTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <Path Grid.Column="0"
                                                                              Data="{Binding IconKey, Converter={StaticResource IconGeometry}}"
                                                                              Stretch="Uniform"
                                                                              Width="17" Height="17"
                                                                              VerticalAlignment="Center"
                                                                              Stroke="{DynamicResource Brush.Text.Primary}"
                                                                              StrokeThickness="1.7"
                                                                              StrokeLineJoin="Round"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round" />

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Title}"
                                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                                   Margin="12,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility.Invert}}" />

                                                                        <Border Grid.Column="2"
                                                                                MinWidth="20"
                                                                                Height="20"
                                                                                Padding="6,0"
                                                                                CornerRadius="{StaticResource Radius.Pill}"
                                                                                Background="{DynamicResource Brush.Accent}"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                                            <TextBlock Text="{Binding Badge}"
                                                                                       FontSize="10.5"
                                                                                       FontWeight="SemiBold"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource Brush.Text.OnAccent}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ToggleButton.ContentTemplate>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Margin="10,0,10,12"
                                Padding="10,9"
                                Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Medium}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Shield}"
                                      Stretch="Uniform"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource Brush.Accent}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round" />
                                <TextBlock Grid.Column="1"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource Text.Caption}"
                                           Text="{loc:Loc Shell.Sidebar.Privacy}"
                                           Visibility="{Binding IsSidebarCompact, Converter={StaticResource BoolToVisibility.Invert}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecalho da tela -->
                    <Grid Grid.Row="0" Margin="26,20,26,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{Binding CurrentSubtitle}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="{loc:Loc Shell.Tooltip.Sidebar}"
                                    Margin="0,0,8,0">
                                <Path Data="{StaticResource Icon.Chevron.Right}"
                                      Stretch="Uniform" Width="13" Height="13"
                                      Stroke="{DynamicResource Brush.Text.Secondary}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round" />
                            </Button>

                            <Border Padding="10,5"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Background="{DynamicResource Brush.Success.Soft}"
                                    ToolTip="{loc:Loc Shell.Elevation.Tooltip}"
                                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Shield}"
                                          Stretch="Uniform" Width="13" Height="13"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource Brush.Success.Text}"
                                          StrokeThickness="1.7"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Text="{Binding ElevationText}"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Font.Size.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Success.Text}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <controls:AnimatedContentControl Grid.Row="1" Margin="26,0,26,16">
                        <ContentControl Content="{Binding CurrentScreen}" />
                    </controls:AnimatedContentControl>
                </Grid>
            </Grid>

            <!-- ========================= BARRA DE STATUS ========================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.TitleBar}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Success}" />
                        <TextBlock Text="{loc:Loc Shell.Status.Monitoring}"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding MemoryUsedText}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="CPU" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" />
                        <controls:Sparkline Width="70" Height="16" Margin="8,0,0,0"
                                            Values="{Binding CpuHistory}"
                                            Capacity="60"
                                            MaxValue="100"
                                            Stroke="{DynamicResource Brush.Accent}" />

                        <TextBlock Text="RAM" Margin="18,0,0,0" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:0}%}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" />
                        <controls:Sparkline Width="70" Height="16" Margin="8,0,0,0"
                                            Values="{Binding MemoryHistory}"
                                            Capacity="60"
                                            MaxValue="100"
                                            Stroke="{DynamicResource Brush.Accent}" />

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDiskActivityAvailable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Shell.Status.Disk}" Margin="18,0,0,0" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DiskPercent, StringFormat={}{0:0}%}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold" />
                            <controls:Sparkline Width="70" Height="16" Margin="8,0,0,0"
                                                Values="{Binding DiskHistory}"
                                                Capacity="60"
                                                MaxValue="100"
                                                Stroke="{DynamicResource Brush.Text.Muted}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="4"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding ProcessCountText}" />
                    <TextBlock Grid.Column="5"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding ClockText}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

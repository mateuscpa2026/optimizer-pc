<UserControl x:Class="OptimizerPC.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:OptimizerPC.App.Localization"
             xmlns:vm="clr-namespace:OptimizerPC.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- Aviso de erro -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Background="{DynamicResource Brush.Danger.Soft}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Warning}"
                          Stretch="Uniform" Width="16" Height="16"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.Danger.Text}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Danger.Text}"
                               TextWrapping="Wrap"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Operacao em andamento -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Label}" />
                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Right"
                                Padding="10,4"
                                MinHeight="26"
                                Command="{Binding CancelCommand}"
                                Content="{loc:Loc Common.Cancel}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                 Margin="0,10,0,0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                </StackPanel>
            </Border>

            <!-- ============ FILTRO ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding FilterLabel}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{Binding Subtitle}"
                                       Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Margin="0,0,8,0"
                                    Command="{Binding ExportCommand}"
                                    IsEnabled="{Binding CanAct}"
                                    Content="{Binding ExportText}" />
                            <Button Style="{StaticResource Button.Danger}"
                                    Command="{Binding ClearCommand}"
                                    IsEnabled="{Binding CanAct}"
                                    Content="{Binding ClearText}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.Accent}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Text"
                                      Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                            <TextBlock Text="{Binding LimitLabel}" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding LimitsOptions}"
                                      SelectedItem="{Binding SelectedLimit}"
                                      MinWidth="90"
                                      Margin="0,6,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource Button.Ghost}"
                                VerticalAlignment="Bottom"
                                Command="{Binding ApplyFilterCommand}"
                                IsEnabled="{Binding CanAct}"
                                Content="{loc:Loc Common.Refresh}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ REGISTROS ============ -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding EntriesTitle}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{Binding EntriesHint}"
                                       Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding RefreshCommand}"
                                Content="{loc:Loc Common.Refresh}" />
                    </Grid>

                    <TextBlock Text="{Binding EntriesSummary}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}" />

                    <ListBox ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             Margin="0,12,0,0"
                             MaxHeight="420"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0"
                                                 Width="8" Height="8"
                                                 Margin="0,4,10,0"
                                                 VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Action}"
                                                       Style="{StaticResource Text.Body}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource Text.Caption}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />

                                            <WrapPanel Margin="0,7,0,0">
                                                <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge.Accent}"
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding HasBytesFreed, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding BytesFreedText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge.Success}"
                                                        Visibility="{Binding HasRestoreRecord, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{loc:Loc History.Badge.Restorable}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimestampText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EntriesEmptyText}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility.Invert}}" />
                </StackPanel>
            </Border>

            <!-- ============ DETALHES ============ -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DetailsTitle}" Style="{StaticResource Text.Section}" />

                    <TextBlock Text="{Binding DetailsEmptyText}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility.Invert}}" />

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedEntry.Action}"
                                   Style="{StaticResource Text.Value}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />

                        <TextBlock Text="{Binding SelectedEntry.Description}"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SelectedEntry.Category}" Style="{StaticResource Badge.Text}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SelectedEntry.StatusText}" Style="{StaticResource Badge.Text}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SelectedEntry.TimestampText}" Style="{StaticResource Badge.Text}" />
                            </Border>
                            <Border Style="{StaticResource Badge.Accent}"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding SelectedEntry.HasBytesFreed, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedEntry.BytesFreedText}" Style="{StaticResource Badge.Text}" />
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{loc:Loc History.Details.Description}"
                                   Style="{StaticResource Text.Label}"
                                   Margin="0,12,0,0" />

                        <Border Style="{StaticResource Card.Inset}" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SelectedEntry.Details}"
                                       Style="{StaticResource Text.Mono}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{loc:Loc History.Details.NoDescription}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding SelectedEntry.HasDetails, Converter={StaticResource BoolToVisibility.Invert}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Margin="0,0,8,0"
                                    Command="{Binding CopyDetailsCommand}"
                                    Content="{Binding CopyDetailsText}" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding OpenRestoreCommand}"
                                    IsEnabled="{Binding CanOpenRestore}"
                                    Content="{Binding RestoreScreenText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Aviso legal -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Info}"
                          Stretch="Uniform" Width="15" Height="15"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.Accent}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding Disclaimer}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

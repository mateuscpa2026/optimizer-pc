<UserControl x:Class="OptimizerPC.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:OptimizerPC.App.Localization"
             xmlns:controls="clr-namespace:OptimizerPC.App.Controls"
             xmlns:vm="clr-namespace:OptimizerPC.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- Aviso de erro -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Background="{DynamicResource Brush.Danger.Soft}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Warning}"
                          Stretch="Uniform" Width="16" Height="16"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.Danger.Text}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Danger.Text}"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Operacao em andamento -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Label}" />
                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Right"
                                Padding="10,4"
                                MinHeight="26"
                                Command="{Binding CancelCommand}"
                                Content="{loc:Loc Common.Cancel}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                 Margin="0,10,0,0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                </StackPanel>
            </Border>

            <!-- ============ INDICE DE SAUDE + METRICAS ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Width="318">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.Score.Title}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{loc:Loc Dashboard.Score.Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                        <controls:GaugeRing Height="182"
                                            Width="182"
                                            Margin="0,14,0,6"
                                            Minimum="0"
                                            Maximum="100"
                                            Thickness="13"
                                            LabelSize="36"
                                            Value="{Binding Score}"
                                            Label="{Binding ScoreText}"
                                            SubLabel="{Binding ScoreCategoryText}"
                                            TrackBrush="{DynamicResource Brush.Inset}"
                                            TextBrush="{DynamicResource Brush.Text.Primary}"
                                            SubTextBrush="{DynamicResource Brush.Text.Muted}">
                            <controls:GaugeRing.Style>
                                <Style TargetType="controls:GaugeRing">
                                    <Setter Property="ProgressBrush" Value="{DynamicResource Brush.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScoreCategory}" Value="Excellent">
                                            <Setter Property="ProgressBrush" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScoreCategory}" Value="Attention">
                                            <Setter Property="ProgressBrush" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScoreCategory}" Value="Critical">
                                            <Setter Property="ProgressBrush" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:GaugeRing.Style>
                        </controls:GaugeRing>

                        <TextBlock Text="{Binding HealthDisclaimer}"
                                   Style="{StaticResource Text.Caption}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />

                        <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource Brush.Border}" />

                        <TextBlock Text="{Binding MachineSummary}"
                                   Style="{StaticResource Text.Body}"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding LastAnalysisText}"
                                   Style="{StaticResource Text.Caption}"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="14,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Loc Dashboard.Metric.Cpu}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                         Margin="0,12,0,0"
                                         Maximum="100"
                                         Value="{Binding CpuPercent}" />
                            <controls:Sparkline Height="34" Margin="0,10,0,0"
                                                Values="{Binding CpuHistory}"
                                                Capacity="60"
                                                MaxValue="100"
                                                Stroke="{DynamicResource Brush.Accent}" />
                        </StackPanel>
                    </Border>

                    <!-- Memoria -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Loc Dashboard.Metric.Memory}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MemoryPercentText}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                         Margin="0,12,0,0"
                                         Maximum="100"
                                         Value="{Binding MemoryPercent}" />
                            <StackPanel Margin="0,10,0,0">
                                <controls:Sparkline Height="20"
                                                    Values="{Binding MemoryHistory}"
                                                    Capacity="60"
                                                    MaxValue="100"
                                                    Stroke="{DynamicResource Brush.Secondary}" />
                                <TextBlock Text="{Binding MemoryText}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Disco -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Loc Dashboard.Metric.Disk}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DiskPercentText}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                         Margin="0,12,0,0"
                                         Maximum="100"
                                         Value="{Binding DiskPercent}" />
                            <TextBlock Text="{loc:Loc Dashboard.Metric.Disk.Hint}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,10,0,0"
                                       Visibility="{Binding IsDiskActivityAvailable, Converter={StaticResource BoolToVisibility.Invert}}" />
                            <controls:Sparkline Height="20"
                                                Margin="0,10,0,0"
                                                Values="{Binding DiskHistory}"
                                                Capacity="60"
                                                MaxValue="100"
                                                Stroke="{DynamicResource Brush.Text.Muted}"
                                                Visibility="{Binding IsDiskActivityAvailable, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Espaco livre -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="12,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Loc Dashboard.Metric.FreeSpace}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FreeSpacePercentText}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                         Margin="0,12,0,0"
                                         Maximum="100"
                                         Value="{Binding FreeSpacePercent}" />
                            <TextBlock Text="{Binding FreeSpaceText}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ ESPACO RECUPERAVEL + SITUACAO ============ -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.Recoverable.Title}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{loc:Loc Dashboard.Recoverable.Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                        <TextBlock Text="{Binding RecoverableText}"
                                   Style="{StaticResource Text.Hero}"
                                   FontSize="32"
                                   Margin="0,12,0,0" />

                        <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0">
                            <Grid>
                                <TextBlock Text="{loc:Loc Dashboard.Recoverable.Temporary}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding TemporaryText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0">
                            <Grid>
                                <TextBlock Text="{loc:Loc Dashboard.Recoverable.RecycleBin}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding RecycleBinText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource Button.Ghost}"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenCleaningCommand}"
                                Content="{loc:Loc Dashboard.Recoverable.Action}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.Status.Title}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{loc:Loc Dashboard.Status.Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                        <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Warning}"
                                          Stretch="Uniform" Width="14" Height="14"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource Brush.Warning.Text}"
                                          StrokeThickness="1.7"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Text="{loc:Loc Dashboard.Status.Problems}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProblemCountText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Optimization}"
                                          Stretch="Uniform" Width="14" Height="14"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource Brush.Accent}"
                                          StrokeThickness="1.7"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Text="{loc:Loc Dashboard.Status.Recommendations}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding RecommendationCountText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Startup}"
                                          Stretch="Uniform" Width="14" Height="14"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource Brush.Text.Secondary}"
                                          StrokeThickness="1.7"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Text="{loc:Loc Dashboard.Status.Startup}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding StartupCountText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource Button.Ghost}"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenDiagnosisCommand}"
                                Content="{loc:Loc Dashboard.Status.Action}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ FATORES + RECOMENDACOES ============ -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.Factors.Title}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{loc:Loc Dashboard.Factors.Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                        <TextBlock Text="{loc:Loc Dashboard.Factors.Empty}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,14,0,0"
                                   Visibility="{Binding HasTopFactors, Converter={StaticResource BoolToVisibility.Invert}}" />

                        <ItemsControl ItemsSource="{Binding TopFactors}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     Margin="0,4,10,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{DynamicResource Brush.Text.Muted}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Info}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Ok">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding LossText}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ScoreText}"
                                                       Style="{StaticResource Text.Label}"
                                                       VerticalAlignment="Top"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Dashboard.Recommendations.Title}" Style="{StaticResource Text.Section}" />
                                <TextBlock Text="{loc:Loc Dashboard.Recommendations.Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource Button.Primary}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Command="{Binding OptimizeNowCommand}"
                                    Content="{loc:Loc Dashboard.Optimize.Action}" />
                        </Grid>

                        <TextBlock Text="{Binding OptimizeResultText}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.Success.Text}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding OptimizeResultText, Converter={StaticResource StringToVisibility}}" />

                        <TextBlock Text="{loc:Loc Dashboard.Recommendations.Empty}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,14,0,0"
                                   Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility.Invert}}" />

                        <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding ImpactText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding RiskText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge.Accent}"
                                                        Visibility="{Binding HasGain, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding GainText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource Button.Ghost}"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenReportsCommand}"
                                Content="{loc:Loc Dashboard.Recommendations.Reports}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{loc:Loc Dashboard.LocalNote}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

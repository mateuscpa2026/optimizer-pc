<UserControl x:Class="OptimizerPC.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:OptimizerPC.App.Localization"
             xmlns:vm="clr-namespace:OptimizerPC.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StorageViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- Aviso de erro -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Background="{DynamicResource Brush.Danger.Soft}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Warning}"
                          Stretch="Uniform" Width="16" Height="16"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.Danger.Text}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Danger.Text}"
                               TextWrapping="Wrap"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Operacao em andamento -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Label}" />
                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Right"
                                Padding="10,4"
                                MinHeight="26"
                                Command="{Binding CancelCommand}"
                                Content="{loc:Loc Common.Cancel}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                 Margin="0,10,0,0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                </StackPanel>
            </Border>

            <!-- ============ RESUMO ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding VolumesTitle}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{loc:Loc Storage.Subtitle}"
                                       Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding RefreshCommand}"
                                Content="{loc:Loc Common.Refresh}" />
                    </Grid>

                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.Accent}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Storage.Summary.Volumes}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding VolumeCountText}" Style="{StaticResource Text.Value}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Storage.Summary.Capacity}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Text.Value}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Storage.Summary.Used}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding UsedSpaceText}" Style="{StaticResource Text.Value}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{loc:Loc Storage.Summary.Free}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource Text.Value}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                 Margin="0,14,0,0"
                                 Maximum="100"
                                 Value="{Binding FreeSpacePercent}" />

                    <TextBlock Text="{loc:Loc Storage.Summary.FreeBar}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,6,0,0" />

                    <!-- Espaco livre baixo -->
                    <Border Style="{StaticResource Card.Inset}"
                            Margin="0,12,0,0"
                            Background="{DynamicResource Brush.Warning.Soft}"
                            BorderBrush="{DynamicResource Brush.Warning}"
                            Visibility="{Binding HasLowSpace, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Warning}"
                                  Stretch="Uniform" Width="15" Height="15"
                                  VerticalAlignment="Top"
                                  Stroke="{DynamicResource Brush.Warning.Text}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding LowSpaceNote}"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Warning.Text}"
                                       TextWrapping="Wrap"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Elevacao pendente -->
            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,12,0,0"
                    Background="{DynamicResource Brush.Warning.Soft}"
                    BorderBrush="{DynamicResource Brush.Warning}"
                    Visibility="{Binding ShowElevationNote, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Shield}"
                          Stretch="Uniform" Width="15" Height="15"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.Warning.Text}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding ElevationNote}"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Warning.Text}"
                               TextWrapping="Wrap"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ VOLUMES ============ -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasVolumes, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Storage.Volumes.List}" Style="{StaticResource Text.Section}" />

                    <ListBox ItemsSource="{Binding Volumes}"
                             SelectedItem="{Binding SelectedVolume}"
                             Margin="0,12,0,0"
                             MaxHeight="320"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource Text.Value}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RootPath}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,3,0,0" />

                                            <WrapPanel Margin="0,7,0,0">
                                                <Border Style="{StaticResource Badge.Info}"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding FileSystem}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge.Accent}"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding DriveTypeText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}"
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding IsSystemDrive, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{loc:Loc Storage.Volume.System}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge.Danger}"
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding IsLowOnSpace, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{loc:Loc Storage.Volume.LowSpaceBadge}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge.Warning}"
                                                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility.Invert}}">
                                                    <TextBlock Text="{loc:Loc Storage.Volume.NotReady}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                            </WrapPanel>

                                            <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                                         Margin="0,10,0,0"
                                                         Maximum="100"
                                                         Value="{Binding UsedPercent, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="130">
                                            <TextBlock Text="{Binding UsedText}"
                                                       Style="{StaticResource Text.Value}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding TotalText}"
                                                       Style="{StaticResource Text.Caption}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding FreePercentText}"
                                                       Style="{StaticResource Text.Caption}"
                                                       HorizontalAlignment="Right"
                                                       Opacity="0.75"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VolumesEmptyText}"
                       Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="{Binding HasVolumes, Converter={StaticResource BoolToVisibility.Invert}}" />

            <!-- ============ MANUTENCAO ============ -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding MaintenanceTitle}" Style="{StaticResource Text.Section}" />

                    <TextBlock Text="{Binding SelectedVolumeTitle}"
                               Style="{StaticResource Text.Value}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <TextBlock Text="{Binding MaintenanceNote}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <TextBlock Text="{loc:Loc Storage.Maintenance.Select}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasSelectedVolume, Converter={StaticResource BoolToVisibility.Invert}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Ghost}"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding CanRunMaintenance}"
                                Command="{Binding TrimCommand}"
                                Content="{loc:Loc Storage.Trim.Run}" />
                        <Button Style="{StaticResource Button.Ghost}"
                                IsEnabled="{Binding CanRunMaintenance}"
                                Command="{Binding CheckDiskCommand}"
                                Content="{loc:Loc Storage.Chkdsk.Run}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ DISPOSITIVOS ============ -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding DevicesTitle}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{Binding DeviceCountText}"
                                   Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Devices}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource Text.Value}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding IndexText}"
                                                           Style="{StaticResource Text.Caption}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeText}"
                                                       Style="{StaticResource Text.Value}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <WrapPanel Margin="0,8,0,0">
                                            <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding MediaText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding BusText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge.Accent}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding HealthText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding HasPowerOnHours, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding PowerOnHoursText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge.Warning}"
                                                    Visibility="{Binding SmartAvailable, Converter={StaticResource BoolToVisibility.Invert}}">
                                                <TextBlock Text="{Binding SmartText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding HealthDetail}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Visibility="{Binding HasHealthDetail, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{Binding SmartText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding SmartAvailable, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DevicesEmptyText}"
                       Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility.Invert}}" />

            <!-- ============ RAIZES DE VARREDURA ============ -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasRoots, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding RootsTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding RootsHint}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <ItemsControl ItemsSource="{Binding Roots}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,0,18,8"
                                          IsChecked="{Binding IsSelected}"
                                          Content="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ USO POR CATEGORIA ============ -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding AnalysisTitle}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{Binding AnalysisHint}"
                                       Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding AnalyzeCommand}"
                                IsEnabled="{Binding IsIdle}"
                                Content="{loc:Loc Storage.Analysis.Run}" />
                    </Grid>

                    <TextBlock Text="{Binding AnalysisEmptyText}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility.Invert}}" />

                    <TextBlock Text="{Binding AnalysisUnavailableNote}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility.Invert}}" />

                    <StackPanel Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{loc:Loc Storage.Analysis.Temporary}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding TemporaryText}"
                                       Style="{StaticResource Text.Value}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="{Binding AnalysisAtText}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,6,0,0" />

                        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CategoryText}"
                                                           Style="{StaticResource Text.Value}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding BytesText}"
                                                               Style="{StaticResource Text.Value}" />
                                                    <TextBlock Text="{Binding ShareText}"
                                                               Style="{StaticResource Text.Caption}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                                         Margin="0,8,0,0"
                                                         Maximum="100"
                                                         Value="{Binding SharePercent, Mode=OneWay}" />

                                            <TextBlock Text="{Binding FilesText}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding AnalysisNote}"
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasAnalysisNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ ARQUIVOS GRANDES ============ -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LargeFileTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding LargeFileHint}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding MinimumSizeLabel}"
                                   Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  Margin="10,0,0,0"
                                  MinWidth="120"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding LargeFileMinimumOptions}"
                                  SelectedItem="{Binding LargeFileMinimum}"
                                  DisplayMemberPath="Text" />

                        <Button Grid.Column="3"
                                Command="{Binding ScanLargeFilesCommand}"
                                IsEnabled="{Binding IsIdle}"
                                Content="{loc:Loc Storage.Large.Run}" />
                    </Grid>

                    <TextBlock Text="{Binding LargeFileSummaryText}"
                               Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.Accent}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasLargeFiles, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding LargeFileEmptyText}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasLargeFiles, Converter={StaticResource BoolToVisibility.Invert}}" />

                    <ItemsControl ItemsSource="{Binding LargeFiles}"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding HasLargeFiles, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       Style="{StaticResource Text.Value}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}" />
                                            <TextBlock Text="{Binding Folder}"
                                                       Style="{StaticResource Text.Caption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" />

                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <Border Style="{StaticResource Badge.Accent}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Extension}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}">
                                                    <TextBlock Text="{Binding LastWriteText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource Button.Ghost}"
                                                VerticalAlignment="Center"
                                                Command="{Binding Path=DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding FullPath}"
                                                Content="{loc:Loc Storage.Path.Copy}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ DUPLICADOS ============ -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DuplicateTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding DuplicateHint}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding MinimumSizeLabel}"
                                   Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  Margin="10,0,0,0"
                                  MinWidth="120"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding DuplicateMinimumOptions}"
                                  SelectedItem="{Binding DuplicateMinimum}"
                                  DisplayMemberPath="Text" />

                        <Button Grid.Column="3"
                                Command="{Binding ScanDuplicatesCommand}"
                                IsEnabled="{Binding IsIdle}"
                                Content="{loc:Loc Storage.Duplicates.Run}" />
                    </Grid>

                    <TextBlock Text="{Binding DuplicateSummaryText}"
                               Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.Accent}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding DuplicateWastedText}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding DuplicateEmptyText}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibility.Invert}}" />

                    <ItemsControl ItemsSource="{Binding DuplicateGroups}"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       Style="{StaticResource Text.Value}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource Badge.Accent}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding FileSizeText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge.Warning}">
                                                    <TextBlock Text="{Binding WastedText}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Hash}"
                                                   Style="{StaticResource Text.Mono}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,8,0,0" />

                                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding FullPath}"
                                                                   Style="{StaticResource Text.Caption}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FullPath}"
                                                                   VerticalAlignment="Center" />

                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource Badge.Info}"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsOldest, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding OldestText}" Style="{StaticResource Badge.Text}" />
                                                        </Border>

                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource Button.Ghost}"
                                                                Margin="10,0,0,0"
                                                                Padding="10,4"
                                                                MinHeight="26"
                                                                Command="{Binding Path=DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding FullPath}"
                                                                Content="{loc:Loc Storage.Path.Copy}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Aviso legal -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Info}"
                          Stretch="Uniform" Width="15" Height="15"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.Accent}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding StorageDisclaimer}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

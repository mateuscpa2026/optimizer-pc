<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta clara: mesmas chaves do tema escuro, com contraste verificado. -->

    <SolidColorBrush x:Key="Brush.Window" Color="#EEF3FA" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardAlt" Color="#F4F8FD" />
    <SolidColorBrush x:Key="Brush.Inset" Color="#F0F5FB" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#E7EEF8" />
    <SolidColorBrush x:Key="Brush.OverlayStrong" Color="#D9E4F3" />

    <SolidColorBrush x:Key="Brush.Border" Color="#D8E1EF" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#BCCBE2" />
    <SolidColorBrush x:Key="Brush.Window.Border" Color="#CBD8EA" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#131C2B" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#4A5A75" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#6F7E99" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#0E86B0" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#0C7AA0" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#0A6C8E" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#DCF0F9" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#0A5D7C" />

    <SolidColorBrush x:Key="Brush.Secondary" Color="#1E9E6A" />
    <SolidColorBrush x:Key="Brush.Secondary.Soft" Color="#DFF5EC" />

    <SolidColorBrush x:Key="Brush.Success" Color="#1E9E6A" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#DFF5EC" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#146B48" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#C07C12" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#FCF1DC" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#8A5A0C" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#C7443F" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#FBE7E6" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#9A2E2B" />

    <SolidColorBrush x:Key="Brush.Info" Color="#2C6FBF" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#E3EEFB" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#1E4E8A" />

    <SolidColorBrush x:Key="Brush.Nav.Hover" Color="#F0F5FC" />
    <SolidColorBrush x:Key="Brush.Nav.Selected" Color="#E1EFFA" />

    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#C3D1E6" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="#A9BDDB" />

    <SolidColorBrush x:Key="Brush.Caption.Hover" Color="#EAEFF7" />
    <SolidColorBrush x:Key="Brush.Caption.CloseHover" Color="#D9534F" />

    <DropShadowEffect x:Key="Effect.Window" BlurRadius="22" ShadowDepth="0" Opacity="0.18" Color="#20304A" />
    <DropShadowEffect x:Key="Effect.Flyout" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#20304A" />

</ResourceDictionary>

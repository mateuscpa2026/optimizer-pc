<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta escura: superficies em azul-marinho da marca, destaque ciano -> verde. -->

    <SolidColorBrush x:Key="Brush.Window" Color="#0B1424" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#0F1B2E" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0F1B2E" />
    <SolidColorBrush x:Key="Brush.Card" Color="#16233A" />
    <SolidColorBrush x:Key="Brush.CardAlt" Color="#1B2B47" />
    <SolidColorBrush x:Key="Brush.Inset" Color="#101C31" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#1F304F" />
    <SolidColorBrush x:Key="Brush.OverlayStrong" Color="#27395C" />

    <SolidColorBrush x:Key="Brush.Border" Color="#24365A" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#33497A" />
    <SolidColorBrush x:Key="Brush.Window.Border" Color="#22345A" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F3F7FC" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#AEBBD2" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7F8FAB" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#05202C" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#2AC7EA" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#4FD3F1" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#1CA5C5" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#123044" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#7FDDF4" />

    <SolidColorBrush x:Key="Brush.Secondary" Color="#3ED598" />
    <SolidColorBrush x:Key="Brush.Secondary.Soft" Color="#10352A" />

    <SolidColorBrush x:Key="Brush.Success" Color="#3ED598" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#10352A" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#7BE8BC" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#F5B759" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#3A2C12" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#F8CE8A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F0716F" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#3A1A1C" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#F5A19F" />

    <SolidColorBrush x:Key="Brush.Info" Color="#62A8F5" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#14283F" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#9CC6F8" />

    <SolidColorBrush x:Key="Brush.Nav.Hover" Color="#16233A" />
    <SolidColorBrush x:Key="Brush.Nav.Selected" Color="#1B2E4E" />

    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#2C4066" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="#3A5385" />

    <SolidColorBrush x:Key="Brush.Caption.Hover" Color="#1E2E4C" />
    <SolidColorBrush x:Key="Brush.Caption.CloseHover" Color="#D9534F" />

    <DropShadowEffect x:Key="Effect.Window" BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="Effect.Flyout" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000" />

</ResourceDictionary>

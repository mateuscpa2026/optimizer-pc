<UserControl x:Class="OptimizerPC.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:OptimizerPC.App.Localization"
             xmlns:vm="clr-namespace:OptimizerPC.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProcessesViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- Aviso de erro -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Background="{DynamicResource Brush.Danger.Soft}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Warning}"
                          Stretch="Uniform" Width="16" Height="16"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.Danger.Text}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Danger.Text}"
                               TextWrapping="Wrap"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Operacao em andamento -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Label}" />
                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Right"
                                Padding="10,4"
                                MinHeight="26"
                                Command="{Binding CancelCommand}"
                                Content="{loc:Loc Common.Cancel}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                 Margin="0,10,0,0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                </StackPanel>
            </Border>

            <!-- ============ RESUMO E FILTRO ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Process.Summary.Title}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsIdle}"
                                Content="{loc:Loc Common.Refresh}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Badge.Accent}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding ProcessCountText}" Style="{StaticResource Badge.Text}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding TotalMemoryText}" Style="{StaticResource Badge.Text}" />
                        </Border>
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="{Binding TotalCpuText}" Style="{StaticResource Badge.Text}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.Accent}"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource TextBox.Search}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Column="1"
                                  Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding BusyOnly}"
                                  Content="{loc:Loc Process.Filter.BusyOnly}" />
                        <CheckBox Grid.Column="2"
                                  Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AutoRefresh}"
                                  Content="{loc:Loc Process.Filter.AutoRefresh}" />

                        <Button Grid.Column="3"
                                Style="{StaticResource Button.Ghost}"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding ClearFilterCommand}"
                                Content="{loc:Loc Process.Filter.Clear}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Necessidade de elevacao -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Background="{DynamicResource Brush.Warning.Soft}"
                    BorderBrush="{DynamicResource Brush.Warning}"
                    Visibility="{Binding ShowElevationNote, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Shield}"
                          Stretch="Uniform" Width="15" Height="15"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.Warning.Text}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding ElevationNote}"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Warning.Text}"
                               TextWrapping="Wrap"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ LISTA ============ -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedProcess}"
                         MaxHeight="460"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Inset}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource Text.Value}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />

                                        <WrapPanel Margin="0,7,0,0">
                                            <Border Style="{StaticResource Badge.Danger}"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding IsSystemCritical, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{loc:Loc Process.Item.Critical}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge.Info}"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding IsElevatedProcess, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{loc:Loc Process.Item.Elevated}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock Style="{StaticResource Badge.Text}">
                                                    <Run Text="{loc:Loc Process.Item.Threads}" /><Run Text=" " /><Run Text="{Binding ThreadCount, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{loc:Loc Process.Item.Handles}" /><Run Text=" " /><Run Text="{Binding HandleCount, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="120">
                                        <TextBlock Text="{Binding MemoryText}"
                                                   Style="{StaticResource Text.Value}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CpuText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding StartedText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.75"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ============ LISTA VAZIA ============ -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility.Invert}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Process.List.Empty}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Process.List.EmptyFilter}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ============ ACOES ============ -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Process.Actions.Title}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding SelectedProcess.Name}"
                               Style="{StaticResource Text.Value}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{loc:Loc Process.Actions.None}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility.Invert}}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc Process.Priority.Label}"
                                   Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1"
                                  MinWidth="180"
                                  MaxWidth="280"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding PriorityOptions}"
                                  DisplayMemberPath="Text"
                                  SelectedValuePath="Hint"
                                  SelectedValue="{Binding SelectedPriority}"
                                  IsEnabled="{Binding HasSelection}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource Button.Ghost}"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding ApplyPriorityCommand}"
                                IsEnabled="{Binding HasSelection}"
                                Content="{loc:Loc Process.Priority.Apply}" />
                    </Grid>

                    <TextBlock Text="{loc:Loc Process.Priority.Note}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <Button Style="{StaticResource Button.Danger}"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0"
                            Command="{Binding EndSelectedCommand}"
                            IsEnabled="{Binding CanEndSelection}"
                            Content="{loc:Loc Process.End.Action}" />

                    <TextBlock Text="{loc:Loc Process.End.Critical}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ SEGURANCA ============ -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Shield}"
                              Stretch="Uniform" Width="15" Height="15"
                              VerticalAlignment="Center"
                              Stroke="{DynamicResource Brush.Success}"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="{loc:Loc Process.Safety.Title}"
                                   Style="{StaticResource Text.Section}"
                                   Margin="9,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding SafetyNote}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

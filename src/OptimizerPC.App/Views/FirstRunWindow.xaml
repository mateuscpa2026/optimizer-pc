<Window x:Class="OptimizerPC.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:OptimizerPC.App.Localization"
        xmlns:controls="clr-namespace:OptimizerPC.App.Controls"
        xmlns:vm="clr-namespace:OptimizerPC.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FirstRunViewModel}"
        Title="Optimizer PC"
        Width="960"
        Height="668"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Marcador da etapa atual na trilha lateral. -->
        <Style x:Key="FirstRun.Dot" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Window.Border}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================= TRILHA LATERAL ========================= -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
                <Grid Margin="28,34,28,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Width="54" Height="54"
                                HorizontalAlignment="Left"
                                CornerRadius="{StaticResource Radius.Large}"
                                Background="{DynamicResource Brush.Accent.Soft}">
                            <Path Data="{StaticResource Icon.Optimization}"
                                  Stretch="Uniform"
                                  Width="28"
                                  Height="28"
                                  Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="1.9"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>

                        <TextBlock Text="{loc:Loc App.Title}"
                                   Style="{StaticResource Text.Title}"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="{loc:Loc App.Slogan}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,26,0,0">
                        <TextBlock Text="{Binding StepText}" Style="{StaticResource Text.Label}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FirstRun.Dot}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}" Value="Welcome">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FirstRun.Dot}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}" Value="Detection">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FirstRun.Dot}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}" Value="Diagnosis">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FirstRun.Dot}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}" Value="Result">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="3" Style="{StaticResource Card.Inset}">
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Shield}"
                                  Stretch="Uniform" Width="16" Height="16"
                                  HorizontalAlignment="Left"
                                  Stroke="{DynamicResource Brush.Success}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round" />
                            <TextBlock Text="{loc:Loc FirstRun.Rail.Privacy}"
                                       Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================= CONTEUDO ========================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Faixa arrastavel com o botao de fechar -->
                <Grid Grid.Row="0">
                    <TextBlock Text="{loc:Loc FirstRun.Window.Title}"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"
                               Margin="28,0,0,0" />
                    <Button Style="{StaticResource Button.Caption.Close}"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseClick"
                            ToolTip="{loc:Loc Shell.Tooltip.Close}">
                        <Path Data="{StaticResource Icon.Window.Close}"
                              Stretch="Uniform" Width="11" Height="11"
                              Stroke="{DynamicResource Brush.Text.Secondary}"
                              StrokeThickness="1.4" />
                    </Button>
                </Grid>

                <!-- Falha inesperada -->
                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Margin="28,0,28,0"
                        Background="{DynamicResource Brush.Danger.Soft}"
                        BorderBrush="{DynamicResource Brush.Danger}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Warning}"
                              Stretch="Uniform" Width="15" Height="15"
                              VerticalAlignment="Top"
                              Stroke="{DynamicResource Brush.Danger.Text}"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Danger.Text}"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="28,20,28,22">

                    <!-- ===== ETAPA 1: APRESENTACAO ===== -->
                    <Grid Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc FirstRun.Welcome.Title}" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="{loc:Loc FirstRun.Welcome.Text}"
                                           Style="{StaticResource Text.Body}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />

                                <Border Style="{StaticResource Card.Inset}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Diagnosis}"
                                                  Stretch="Uniform" Width="15" Height="15"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Accent}"
                                                  StrokeThickness="1.7"
                                                  StrokeLineJoin="Round" />
                                            <TextBlock Text="{loc:Loc FirstRun.Welcome.Diagnose}"
                                                       Style="{StaticResource Text.Label}"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{loc:Loc FirstRun.Welcome.Diagnose.Text}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="25,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Optimization}"
                                                  Stretch="Uniform" Width="15" Height="15"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Accent}"
                                                  StrokeThickness="1.7"
                                                  StrokeLineJoin="Round" />
                                            <TextBlock Text="{loc:Loc FirstRun.Welcome.Optimize}"
                                                       Style="{StaticResource Text.Label}"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{loc:Loc FirstRun.Welcome.Optimize.Text}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="25,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Restore}"
                                                  Stretch="Uniform" Width="15" Height="15"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Accent}"
                                                  StrokeThickness="1.7"
                                                  StrokeLineJoin="Round" />
                                            <TextBlock Text="{loc:Loc FirstRun.Welcome.Restore}"
                                                       Style="{StaticResource Text.Label}"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{loc:Loc FirstRun.Welcome.Restore.Text}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="25,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Margin="0,0,10,0"
                                    Command="{Binding SkipCommand}"
                                    IsEnabled="{Binding CanLeaveWelcome}"
                                    Content="{loc:Loc FirstRun.Action.Skip}" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Command="{Binding BeginCommand}"
                                    IsEnabled="{Binding CanLeaveWelcome}"
                                    Content="{loc:Loc FirstRun.Action.Begin}" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== ETAPA 2: DETECCAO ===== -->
                    <Grid Visibility="{Binding IsDetectionStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc FirstRun.Detect.Title}" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="{loc:Loc FirstRun.Detect.Subtitle}"
                                           Style="{StaticResource Text.Body}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />

                                <StackPanel Margin="0,18,0,0"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Label}" />
                                    <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                                 Margin="0,10,0,0"
                                                 Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Facts}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Label}"
                                                               Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Value}"
                                                               Style="{StaticResource Text.Label}"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Right"
                                                               MaxWidth="330"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="16,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Margin="0,0,10,0"
                                    Command="{Binding BackCommand}"
                                    Content="{loc:Loc Common.Back}" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Command="{Binding NextCommand}"
                                    IsEnabled="{Binding CanAdvance}"
                                    Content="{loc:Loc FirstRun.Action.Next}" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== ETAPA 3: DIAGNOSTICO ===== -->
                    <Grid Visibility="{Binding IsDiagnosisStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc FirstRun.Diagnose.Title}" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="{loc:Loc FirstRun.Diagnose.Subtitle}"
                                           Style="{StaticResource Text.Body}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />

                                <StackPanel Margin="0,18,0,0"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Label}" />
                                    <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                                                 Margin="0,10,0,0"
                                                 Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                                </StackPanel>

                                <Border Style="{StaticResource Card.Inset}"
                                        Margin="0,18,0,0"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Check}"
                                                  Stretch="Uniform" Width="15" Height="15"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Success}"
                                                  StrokeThickness="1.9"
                                                  StrokeLineJoin="Round" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{StaticResource Text.Label}"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding VerifiedCountText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Margin="25,5,0,0" />
                                        <TextBlock Text="{loc:Loc FirstRun.Diagnose.ReadOnly}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="25,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card.Inset}"
                                        Margin="0,18,0,0"
                                        Background="{DynamicResource Brush.Info.Soft}"
                                        BorderBrush="{DynamicResource Brush.Info}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Info}"
                                              Stretch="Uniform" Width="15" Height="15"
                                              VerticalAlignment="Top"
                                              Stroke="{DynamicResource Brush.Info.Text}"
                                              StrokeThickness="1.7"
                                              StrokeLineJoin="Round" />
                                        <TextBlock Text="{loc:Loc FirstRun.Diagnose.Running}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Foreground="{DynamicResource Brush.Info.Text}"
                                                   TextWrapping="Wrap"
                                                   Margin="10,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Margin="0,0,10,0"
                                    Command="{Binding BackCommand}"
                                    IsEnabled="{Binding CanAdvance}"
                                    Content="{loc:Loc Common.Back}" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Command="{Binding NextCommand}"
                                    IsEnabled="{Binding CanAdvance}"
                                    Content="{loc:Loc FirstRun.Action.SeeResult}" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== ETAPA 4: RESULTADO ===== -->
                    <Grid Visibility="{Binding IsResultStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc FirstRun.Result.Title}" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="{loc:Loc FirstRun.Result.Subtitle}"
                                           Style="{StaticResource Text.Body}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:GaugeRing Grid.Column="0"
                                                        Width="150"
                                                        Height="150"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Thickness="12"
                                                        LabelSize="29"
                                                        Value="{Binding Score}"
                                                        Label="{Binding ScoreText}"
                                                        SubLabel="{Binding ScoreCategoryText}"
                                                        TrackBrush="{DynamicResource Brush.Inset}"
                                                        TextBrush="{DynamicResource Brush.Text.Primary}"
                                                        SubTextBrush="{DynamicResource Brush.Text.Muted}">
                                        <controls:GaugeRing.Style>
                                            <Style TargetType="controls:GaugeRing">
                                                <Setter Property="ProgressBrush" Value="{DynamicResource Brush.Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScoreCategory}" Value="Excellent">
                                                        <Setter Property="ProgressBrush" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ScoreCategory}" Value="Attention">
                                                        <Setter Property="ProgressBrush" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ScoreCategory}" Value="Critical">
                                                        <Setter Property="ProgressBrush" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:GaugeRing.Style>
                                    </controls:GaugeRing>

                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc FirstRun.Result.Ready}" Style="{StaticResource Text.Section}" TextWrapping="Wrap" />
                                        <TextBlock Text="{loc:Loc FirstRun.Result.Ready.Text}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Border Style="{StaticResource Badge.Danger}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CriticalCountText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge.Warning}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding WarningCountText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge.Success}">
                                                <TextBlock Text="{Binding VerifiedCountText}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card.Inset}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProblemCountText}" Style="{StaticResource Text.Value}" />
                                            <TextBlock Text="{loc:Loc FirstRun.Result.Problems}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card.Inset}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RecommendationCountText}" Style="{StaticResource Text.Value}" />
                                            <TextBlock Text="{loc:Loc FirstRun.Result.Recommendations}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card.Inset}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RecoverableText}" Style="{StaticResource Text.Value}" />
                                            <TextBlock Text="{loc:Loc FirstRun.Result.Recoverable}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card.Inset}" Margin="8,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StartupCountText}" Style="{StaticResource Text.Value}" />
                                            <TextBlock Text="{loc:Loc FirstRun.Result.Startup}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding HealthDisclaimer}"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,14,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Margin="0,0,10,0"
                                    Command="{Binding ExploreCommand}"
                                    Content="{loc:Loc FirstRun.Action.Explore}" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Command="{Binding StartDiagnosisCommand}"
                                    Content="{loc:Loc FirstRun.Action.StartDiagnosis}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
